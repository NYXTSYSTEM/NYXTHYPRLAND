# changed break config

font=Cozette 11
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=DP-2
layer=overlay
anchor=top-right
background-color=#0c0c1c
text-color=#c2c2c6
width=300
height=110
margin=5
padding=0,5,10
border-size=2
border-color=#655498
border-radius=15
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

[urgency=normal]
border-color=#4233A2
[urgency=high]
border-color=#5A4D65
default-timeout=0
[app-name=lightcord]
border-color=#655498
[summary~="log-.*"]
border-color=#937975
[app-name=lightcord summary~="(.*(^| )orz|ORZ|sto|STO|otl|OTL( |$).*)"]
invisible=1
